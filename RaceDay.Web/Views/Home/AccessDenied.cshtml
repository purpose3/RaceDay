@inject UserSession Me
@{ ViewData["Title"] = "Access denied"; }
<div class="rd-empty">
    <div class="rd-empty-icon">🚫</div>
    <h1 class="rd-title">That area isn't for your account type</h1>
    <p class="text-muted">
        You're signed in as @(Me.Role == "Organiser" ? "an Organiser" : "a Participant"), and this page belongs to
        @(Me.Role == "Organiser" ? "Participants" : "Organisers").
    </p>
    @if (Me.IsOrganiser)
    {
        <a asp-controller="Organiser" asp-action="Dashboard" class="btn btn-primary">Go to my dashboard</a>
    }
    else
    {
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to events</a>
    }
</div>
