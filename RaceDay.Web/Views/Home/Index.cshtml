@model List<EventSummary>
@inject UserSession Me
@{
    ViewData["Title"] = "Upcoming events";
    var location = ViewBag.Location as string;
    var date = ViewBag.Date as string;
    var filtered = !string.IsNullOrWhiteSpace(location) || !string.IsNullOrWhiteSpace(date);
}

<section class="rd-hero mb-4">
    <div class="rd-hero-inner">
        <p class="rd-kicker">South African road running · walking · cycling</p>
        <h1>Find your next finish line.</h1>
        <p class="lead">Browse upcoming events, pick your distance and enrol in minutes.</p>
        @if (!Me.IsAuthenticated)
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg me-2">Join RaceDay</a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg">Log in</a>
        }
    </div>
</section>

<form method="get" asp-action="Index" class="card rd-panel mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label for="location" class="form-label">Location</label>
                <input type="text" id="location" name="location" value="@location" class="form-control" placeholder="e.g. Pretoria, Cape Town, Durban" />
            </div>
            <div class="col-md-4">
                <label for="date" class="form-label">Date</label>
                <input type="date" id="date" name="date" value="@date" class="form-control" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">Filter</button>
                @if (filtered)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </div>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="rd-empty">
        <div class="rd-empty-icon">🏁</div>
        <h2>@(filtered ? "No events match your filters" : "No upcoming events yet")</h2>
        <p class="text-muted">@(filtered ? "Try a different location or date, or clear the filters." : "Check back soon: new events are added all the time.")</p>
        @if (filtered)
        {
            <a asp-action="Index" class="btn btn-primary">Show all events</a>
        }
    </div>
}
else
{
    <h2 class="rd-section">@(filtered ? "Matching events" : "Upcoming events") <span class="rd-count">@Model.Count</span></h2>
    <div class="row g-4">
        @foreach (var e in Model)
        {
            <div class="col-md-6 col-lg-4">
                <partial name="_EventCard" model="e" />
            </div>
        }
    </div>
}
