@model EventSummary
<div class="card rd-card h-100">
    <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.EventId" class="rd-card-media text-decoration-none">
        @if (Model.BannerUrl is not null)
        {
            <img src="~/media/event/@Model.EventId" alt="Banner for @Model.EventName" loading="lazy" />
        }
        else
        {
            <div class="rd-card-placeholder"><span>@Format.EventIcon(Model.EventType)</span></div>
        }
        <span class="rd-date-badge">
            <strong>@Model.EventDate.ToString("dd")</strong>
            <small>@Model.EventDate.ToString("MMM").ToUpperInvariant()</small>
        </span>
        <span class="rd-type-chip">@Model.EventType</span>
    </a>
    <div class="card-body d-flex flex-column">
        <h3 class="rd-card-title">@Model.EventName</h3>
        <p class="text-muted mb-1">📍 @Model.Location</p>
        <p class="text-muted mb-3">🏁 @Format.Km(Model.DistanceKm) · @Format.Date(Model.EventDate)</p>
        <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-primary mt-auto">View event</a>
    </div>
</div>
